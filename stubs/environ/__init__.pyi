import builtins
from typing import overload

class NoValue: ...

class Env:
    NOTSET: NoValue

    def __init__(self, **scheme: object) -> None: ...
    @overload
    def str(self, var: builtins.str, default: builtins.str | NoValue = ...) -> builtins.str: ...
    @overload
    def str(self, var: builtins.str, default: None) -> builtins.str | None: ...
    def bool(self, var: builtins.str, default: builtins.bool | NoValue = ...) -> builtins.bool: ...
    def list(
        self, var: builtins.str, default: builtins.list[builtins.str] | NoValue = ...
    ) -> builtins.list[builtins.str]: ...
    def db(
        self, var: builtins.str = ..., default: builtins.str | NoValue = ...
    ) -> dict[builtins.str, object]: ...
