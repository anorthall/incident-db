# Production environment variables.
#
# On the AWS deployment this file is NOT used: deploy.sh renders /opt/cidb/prod.env
# from SSM Parameter Store under /cidb/prod/. This template documents the same set
# of variables for reference and for any other deployment target.

SECRET_KEY=
DATABASE_URL=postgres://user:password@host:5432/dbname  # pragma: allowlist secret
DJANGO_ALLOWED_HOSTS=incidents.caves.org
CSRF_TRUSTED_ORIGINS=https://incidents.caves.org
CORS_ALLOWED_ORIGINS=https://incidents.caves.org

API_DOMAIN=api.incidents.caves.org
ACME_EMAIL=

# PORT=8000
# WEB_CONCURRENCY=3

# Credentials are omitted on EC2 so boto3 uses the instance role.
# AWS_S3_REGION_NAME=us-west-2
# AWS_STORAGE_BUCKET_NAME=nss-incidents-cdn
# AWS_S3_CUSTOM_DOMAIN=incidents.caves.org/cdn
# BACKUP_BUCKET=nss-incidents-backups

# SENTRY_DSN=
# SENTRY_CRON_URL=
# LOGFIRE_TOKEN=
# LOG_LEVEL=WARNING
